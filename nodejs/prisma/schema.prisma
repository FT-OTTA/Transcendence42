datasource db {
  provider = "mysql"
  url      = "mysql://user:prout@mysql:3306/otta"
}

generator client {
  provider = "prisma-client-js"
}

model Card {
  id String @id

  name_en String
  name_fr String
  name_sv String

  type_en String
  type_fr String
  type_sv String

  effect_text_en String
  effect_text_fr String
  effect_text_sv String

  class String
  force Int?
  endurance Int?
  rune_cost Int
  effect String @db.Text
  illustration String
  target_number Int?
  target_type String?
  timing String @default("end_of_turn")

}

model Hero {
  id String @id

  name_en String
  name_fr String
  name_sv String

  passive_text_en String
  passive_text_fr String
  passive_text_sv String

  base_armor Int
  passive_json_path String
  illustration String
  deck String @db.Text
}

model User {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())

  username      String   @unique
  passwordHash  String   @map("password_hash")

  moodphrase    String?
  avatarUrl     String?

  friends       Friendship[] @relation("UserFriends")
  friendOf      Friendship[] @relation("FriendOf")

  createdRooms  Room[] @relation("Player1")
  joinedRooms   Room[] @relation("Player2")
  messages      Message[]

  gamesWon  GameResult[] @relation("GameWinner")
  gamesLost GameResult[] @relation("GameLoser")
  gamesAsP1   GameResult[] @relation("GamePlayer1")
  gamesAsP2   GameResult[] @relation("GamePlayer2")

}

model GameResult {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())

    winnerId  Int?
    loserId   Int?
    player1Id Int
    player2Id Int
    player1Class String
    player2Class String

    turns        Int
    player1Score Int @default(0)
    player2Score Int @default(0)

    winner    User? @relation("GameWinner", fields: [winnerId], references: [id])
    loser     User? @relation("GameLoser", fields: [loserId], references: [id])
    player1   User  @relation("GamePlayer1", fields: [player1Id], references: [id])
    player2   User  @relation("GamePlayer2", fields: [player2Id], references: [id])

}

model Friendship {
  id        Int @id @default(autoincrement())
  userId    Int
  friendId  Int

  user      User @relation("UserFriends", fields: [userId], references: [id])
  friend    User @relation("FriendOf", fields: [friendId], references: [id])

  @@unique([userId, friendId], name: "userId_friendId")
}

model Room {
  id          Int      @id @default(autoincrement())

  player1Id   Int
  player2Id   Int?

  status      String   @default("waiting")

  createdAt   DateTime @default(now())

  player1     User @relation("Player1", fields: [player1Id], references: [id])
  player2     User? @relation("Player2", fields: [player2Id], references: [id])
  messages    Message[]
}

model Message {
  id          Int       @id @default(autoincrement())
  content     String    @db.Text
  createdAt   DateTime @default(now())

  senderId  Int
  sender     User @relation(fields: [senderId], references: [id])

  roomId    Int?
  room      Room? @relation(fields: [roomId], references: [id])

}

