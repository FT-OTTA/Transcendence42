datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Card {
  id String @id
  name String
  type String
  class String
  force Int?
  endurance Int?
  rune_cost Int
  effect_text String
  effect String @db.Text
  illustration String
  target_number Int?
  target_type String?
  timing String @default("end_of_turn")

}

model Hero {
  id String @id
  name String
  base_armor Int
  passive_text String
  passive_json_path String
  illustration String
  deck String @db.Text
}

model User {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())

  username      String   @unique
  passwordHash  String   @map("password_hash")

  friends       Friendship[] @relation("UserFriends")
  friendOf      Friendship[] @relation("FriendOf")

  createdRooms  Room[] @relation("Player1")
  joinedRooms   Room[] @relation("Player2")
  messages      Message[]

  gamesWon  GameResult[] @relation("GameWinner")
  gamesLost GameResult[] @relation("GameLoser")

}

model GameResult {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())

    winnerId  Int
    loserId   Int
    turns     Int

    winner    User @relation("GameWinner", fields: [winnerId], references: [id])
    loser     User @relation("GameLoser", fields: [loserId], references: [id])
}

model Friendship {
  id        Int @id @default(autoincrement())
  userId    Int
  friendId  Int

  user      User @relation("UserFriends", fields: [userId], references: [id])
  friend    User @relation("FriendOf", fields: [friendId], references: [id])

  @@unique([userId, friendId], name: "userId_friendId")
}

model Room {
  id          Int      @id @default(autoincrement())

  player1Id   Int
  player2Id   Int?

  status      String   @default("waiting")

  createdAt   DateTime @default(now())

  player1     User @relation("Player1", fields: [player1Id], references: [id])
  player2     User? @relation("Player2", fields: [player2Id], references: [id])
  messages    Message[]
}

model Message {
  id          Int       @id @default(autoincrement())
  content     String    @db.Text
  createdAt   DateTime @default(now())

  senderId  Int
  sender     User @relation(fields: [senderId], references: [id])

  roomId    Int?
  room      Room? @relation(fields: [roomId], references: [id])

}

